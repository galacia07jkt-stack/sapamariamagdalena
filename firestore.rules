rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /warga/{wargaId} {
      allow read: if true;
      allow create: if request.resource.data.namaLengkap is string
                    && request.resource.data.namaLengkap.size() > 0;
      allow update: if request.resource.data.namaLengkap is string
                    && request.resource.data.namaLengkap.size() > 0;
      allow delete: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
